# Copy to .env for local backend development and replace placeholders.
DATABASE_URL=postgresql+asyncpg://<DB_USER>:<DB_PASSWORD>@localhost:5433/<DB_NAME>
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=<MINIO_ACCESS_KEY>
MINIO_SECRET_KEY=<REPLACE_WITH_STRONG_SECRET>
MINIO_BUCKET_NAME=study-files
JWT_SECRET=<GENERATE_A_LONG_RANDOM_SECRET>
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720
ADMIN_USERNAME=<ADMIN_USERNAME>
ADMIN_PASSWORD=<REPLACE_WITH_STRONG_PASSWORD>
CORS_ORIGINS=http://localhost:3000
