# Copy to .env for local configuration. Replace all placeholder values.
DATABASE_URL=postgresql+asyncpg://<DB_USER>:<DB_PASSWORD>@postgres_db:5432/<DB_NAME>
POSTGRES_USER=<DB_USER>
POSTGRES_PASSWORD=<REPLACE_WITH_STRONG_PASSWORD>
POSTGRES_DB=studyhub
POSTGRES_PORT=5433

MINIO_ENDPOINT=minio_storage:9000
MINIO_ACCESS_KEY=<MINIO_ACCESS_KEY>
MINIO_SECRET_KEY=<REPLACE_WITH_STRONG_SECRET>
MINIO_BUCKET_NAME=study-files
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

JWT_SECRET=<GENERATE_A_LONG_RANDOM_SECRET>
ADMIN_USERNAME=<ADMIN_USERNAME>
ADMIN_PASSWORD=<REPLACE_WITH_STRONG_PASSWORD>
CORS_ORIGINS=http://localhost:3000

# Public browser API address is same-origin through the frontend.
NEXT_PUBLIC_API_URL=
